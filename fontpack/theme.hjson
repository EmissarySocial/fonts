{
	themeId: "fontpack"

	// Every font in this pack, shaped as form.LookupCode so a font picker can read it
	// directly.  Value is the CSS family name to write into font-family; Href is the ONE
	// file to load for that family -- the variable upright where the family has one,
	// because that single file already carries every weight, otherwise the regular.
	// Italics and static weights sit beside it in the same folder.
